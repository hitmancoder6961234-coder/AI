# Darkness AI - environment variables.
# Copy to .env (never commit it). On Render/Vercel enter these in the dashboard instead.

# ---- Runtime --------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Where SQLite, uploads and projects live. Mount a persistent disk/volume here.
DARKNESS_STORAGE_ROOT=/data

# ---- Privacy & hardening (secure by default) ------------------------------------------------
# true  = every API route needs a signed-in session; no shared demo account; no anonymous access.
# false = original open behaviour. Local hacking ONLY - never on a public server.
PRIVACY_STRICT=true
# Content-Security-Policy mode: enforce (default in production) | report-only (same policy, nothing blocked: the default in development, or to try a change) | off (local debugging)
PRIVACY_CSP=enforce
# Optional CSP additions (space or comma separated, https:// or wss:// origins only; anything else is ignored):
# CSP_CONNECT_EXTRA=https://api.example.com   # hosts the browser may call
# CSP_IMG_EXTRA=https://images.example.com    # more image hosts (default: GitHub, shields.io, Google avatars)
# CSP_IMG_ALLOW_ALL=false                     # true = any https image (weakens the policy)
# CSP_UPGRADE_INSECURE=false                  # true only when served over HTTPS
# Classic app only: CSP_CLASSIC_STYLE_HASHES=  CSP_CLASSIC_STYLE_INLINE=false  CSP_CLASSIC_ALLOW_EVAL=false
# Hops between the app and the real client IP: 1 behind one proxy, 2 behind Vercel -> Render.
TRUST_PROXY_HOPS=1
# Browser origins allowed to call the API cross-origin (comma separated). Empty = same-origin only.
CORS_ORIGINS=
# Only for a split-origin setup without the Vercel proxy: COOKIE_SAMESITE=none
COOKIE_SAMESITE=
# Code execution (terminals/run/preview) is OFF by default. Enable ONLY on a private single-user instance.
ENABLE_RUN_ENGINE=false
# Request-body size limits for JSON / form requests, per kind of route (megabytes; unusable values keep the default). Defaults are right for most setups.
# Large files use the multipart upload routes, which have their own limits. See docs/ENVIRONMENT-VARIABLES.md.
# JSON_LIMIT_DEFAULT_MB=1     structured data: accounts, memory, prompts, models, settings, ids
# JSON_LIMIT_AI_MB=25         requests that go to a model: long prompts, pasted documents, base64 image attachments
# JSON_LIMIT_FILES_MB=100     file and export content sent as JSON (shared files, project files, document / slide exports)
# Rate limits
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_AUTH_PER_15MIN=20
# Wrong passwords allowed per account+address before sign-in pauses (60 s, then 5 min, then 15 min)
LOGIN_MAX_FAILS=5
LOGIN_LOCK_SECONDS=60
RATE_LIMIT_AI_PER_MIN=40
# Redact e-mails, tokens, keys and IPs from server logs (leave true)
PRIVACY_LOG_REDACTION=true
# 32 random bytes, base64 (EXACTLY 32 bytes: any other length leaves the vault off). Generate with: scripts/new-secrets.ps1
# With it set, API keys that users save for their models are encrypted at rest (AES-256-GCM) and so is the Aiven mirror. Back it up
# separately from the database: without it sealed keys cannot be read. See DEPLOY.md "Provider API keys at rest".
PRIVACY_ENCRYPTION_KEY=
# Key rotation only: the OLD key while you re-seal with a new PRIVACY_ENCRYPTION_KEY (SECRETS_MIGRATE=rotate), then remove it.
# PRIVACY_ENCRYPTION_KEY_PREVIOUS=
# One-time conversion at boot, then unset it: encrypt = seal existing plaintext keys, rotate = re-seal under the current key.
# A snapshot is written to <storage root>/backups first; nothing changes if any value fails.
# SECRETS_MIGRATE=

# ---- Account recovery by e-mail (optional) ------------------------------------------------------
# Unset = "Forgot password?" says it is unavailable and the operator issues one-time links from the host:
#   node scripts/admin.mjs reset-link <email>      (see DEPLOY.md "Account recovery")
# Settings that are incomplete are treated as "not configured" (the app never pretends to send mail); `npm run preflight` names what is missing.
# MAIL_PROVIDER=smtp                      # smtp | resend
# MAIL_FROM=Darkness AI <no-reply@your-domain>
# PUBLIC_APP_URL=https://your-app.example # where the link in the e-mail points (https required in production)
# smtp:   SMTP_HOST=, SMTP_PORT=587, SMTP_TLS=starttls (starttls | implicit | none; none only for localhost), SMTP_USER=, SMTP_PASS= (set both or neither)
# resend: RESEND_API_KEY=
# These have NOT been exercised against a real mail provider in this repository: follow docs/OPERATIONS-VERIFICATION.md before relying on them.

# ---- AI providers (set at least one) --------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=

# ---- Copilot ----------------------------------------------------------------------------------
# With OPENAI_API_KEY set, the Copilot talks to OpenAI GPT directly. Needs an OpenAI API key
# (platform.openai.com) - a ChatGPT Plus/Pro subscription is a different product and has no API key.
COPILOT_MODEL=gpt-4o-mini
# Optional: lock every Copilot chat to one topic for all users (they cannot widen it), e.g. "our product's documentation"
COPILOT_LOCK_TOPIC=

# ---- Illustrations -----------------------------------------------------------------------------
# Images use the server's GEMINI_API_KEY. Set true to ALSO allow a free third-party generator
# (pollinations.ai) - your image prompts are then sent to that service. Off by default.
IMAGE_ALLOW_THIRD_PARTY=false

# ---- Agent ----------------------------------------------------------------------------------
# Optional. Defaults to the first provider that has a key.
AGENT_PROVIDER=
AGENT_MODEL=
# Only for OpenAI-compatible providers hosted elsewhere (e.g. a self-hosted gateway)
AGENT_BASE_URL=

# ---- Aiven PostgreSQL mirror (optional, needs PRIVACY_ENCRYPTION_KEY) -----------------------
# Service URI from the Aiven console, and the project CA certificate (PEM text or a file path).
AIVEN_PG_URI=
AIVEN_CA_CERT=

# ---- Supabase (optional, original Darkness cloud sync) ---------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Uploads ----------------------------------------------------------------------------------
# Uploaded files are streamed to a private temp folder (default: <system temp>/darkness-uploads) and deleted when the request
# ends; leftovers are swept at start-up and every 10 minutes. Point it at a bigger/faster disk if you accept large uploads.
# DARKNESS_UPLOAD_TMP=

# ---- Reliability & logging ---------------------------------------------------------------------
# Provider calls: every call has a timeout, transient failures (network, 408/429/500/502/503/504/529) are retried a few
# times with backoff, client errors (400/401/403/404...) never are. Values are milliseconds unless noted.
# PROVIDER_TIMEOUT_MS=120000          whole non-streaming call
# PROVIDER_HEADERS_TIMEOUT_MS=60000   wait for the first byte of a streaming answer
# PROVIDER_STREAM_IDLE_MS=60000       longest silence allowed between chunks of a streaming answer
# PROVIDER_MAX_ATTEMPTS=3             1 turns retries off
# PROVIDER_RETRY_BASE_MS=500
# PROVIDER_RETRY_MAX_MS=8000
# PROVIDER_RETRY_BUDGET_MS=30000      stop retrying after this much total time
# Logs: JSON lines in production (readable lines in development). Never contains keys, tokens, passwords or prompts.
# LOG_FORMAT=json                     json | pretty
# LOG_LEVEL=info                      debug | info | warn | error
# LOG_ACCESS=true                     one access-log line per request (health checks are never logged)
# Readiness / shutdown
# READINESS_MIN_FREE_MB=100           /api/ready fails below this much free disk space
# SHUTDOWN_GRACE_MS=10000             time given to in-flight requests after SIGTERM

# ---- Advanced / rarely needed (all optional; found undocumented by the final audit) ----------
# DARKNESS_DB_PATH=                   exact SQLite file (default: <DARKNESS_STORAGE_ROOT>/database/darkness.db); scripts/backup.mjs honours it
# DARKNESS_ALLOW_NEWER_SCHEMA=false  start even if the database was written by a NEWER build (default: refuse); see docs/OPERATIONS-VERIFICATION.md section 7
# DARKNESS_PROJECTS_DIR=              where generated projects live (default: ./data/projects; set it to a persistent volume)
# DARKNESS_UPLOAD_IDLE_MS=            abort an upload that sends nothing for this long
# DEFAULT_GEMINI_MODEL=               model used when a request names none
# GOOGLE_GENAI_API_KEY=               alternative names the server also accepts for GEMINI_API_KEY: GOOGLE_API_KEY, GOOGLE_GENAI_API_KEY,
#                                     VITE_GEMINI_API_KEY, VITE_GOOGLE_API_KEY. Prefer GEMINI_API_KEY: a VITE_-prefixed variable present at
#                                     BUILD time can be inlined into browser code by Vite, so never set the VITE_ ones on a build machine.
# OPENAI_BASE_URL=                    base URL for the agent's OpenAI-compatible provider
# AIVEN_ALLOW_PLAINTEXT=false         the Aiven mirror stays off unless the vault key is set; true allows storing plaintext (not recommended)
# CSP_CLASSIC_ALLOW_EVAL=false        the Classic app's policy never allows eval unless this is true
# CSP_CLASSIC_STYLE_INLINE=false      coarse fallback if the Classic app's Google sign-in style needs another hash (see SECURITY.md)
# BACKEND_URL=                        Vercel only: the https origin of the API service that api/proxy.js forwards to

# ---- Docker compose only --------------------------------------------------------------------
HOST_PORT=3000
